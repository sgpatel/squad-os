<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.sgpatel</groupId>
  <artifactId>squad-os</artifactId>
  <version>3.1.0</version>
  <packaging>pom</packaging>
  <name>SquadOS</name>
  <description>SquadOS — Multi-Agent AI Framework for Java. Role-typed agents, parallel execution, and persistent memory. Spring Boot style.</description>

  <modules>
    <module>squad-core</module>
    <module>squad-starter</module>
    <module>squad-examples/daily-planner</module>
    <module>squad-examples/code-review</module>
    <module>squad-examples/embedding-demo</module>
    <module>squad-examples/snack-thief</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>


  <!-- Maven Central Publishing -->
  <url>https://github.com/sgpatel/squad-os</url>

  <licenses>
    <license>
      <name>Apache License 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>squados</id>
      <name>SquadOS Team</name>
      <email>sgpatel@github.com</email>
      <organization>SquadOS</organization>
      <organizationUrl>https://github.com/sgpatel/squad-os</organizationUrl>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:git://github.com/sgpatel/squad-os.git</connection>
    <developerConnection>scm:git:ssh://github.com/sgpatel/squad-os.git</developerConnection>
    <url>https://github.com/sgpatel/squad-os</url>
    <tag>HEAD</tag>
  </scm>

  <!-- central-publishing-maven-plugin handles distribution automatically -->
  <!-- No distributionManagement URLs needed for new Central Portal -->

  <profiles>
    <!-- Activate for Maven Central release: mvn deploy -P release -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <!-- Generate sources jar -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.0</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals><goal>jar-no-fork</goal></goals>
              </execution>
            </executions>
          </plugin>
          <!-- Generate javadoc jar -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.6.3</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals><goal>jar</goal></goals>
              </execution>
            </executions>
            <configuration>
              <doclint>none</doclint>
            </configuration>
          </plugin>
          <!-- GPG signing (required by Maven Central) -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
              </execution>
            </executions>
            <configuration>
              <!-- GPG key passphrase stored in ~/.m2/settings.xml or env var -->
              <gpgArguments>
                <arg>--pinentry-mode</arg>
                <arg>loopback</arg>
              </gpgArguments>
            </configuration>
          </plugin>
          <!-- Sonatype Central Portal publishing plugin (new, replaces nexus-staging) -->
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.6.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>true</autoPublish>
              <waitUntil>published</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
