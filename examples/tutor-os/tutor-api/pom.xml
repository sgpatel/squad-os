<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.tutoros</groupId>
    <artifactId>tutor-os-parent</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>tutor-api</artifactId>
  <name>TutorOS API — Spring Boot REST + WebSocket</name>

  <dependencies>

    <!-- TutorOS core (agents + pipeline) -->
    <dependency>
      <groupId>io.tutoros</groupId>
      <artifactId>tutor-core</artifactId>
      <version>1.0.0</version>
    </dependency>

    <!-- SquadOS Spring Boot Starter — wires all beans automatically -->
    <dependency>
      <groupId>io.github.sgpatel</groupId>
      <artifactId>squad-spring-boot-starter</artifactId>
      <version>${squad-os.version}</version>
    </dependency>

    <!-- squad-mcp-server — exposes TutorOS agents as MCP tools -->
    <dependency>
      <groupId>io.github.sgpatel</groupId>
      <artifactId>squad-mcp-server</artifactId>
      <version>${squad-os.version}</version>
    </dependency>

    <!-- Spring Boot Web + WebSocket -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Actuator — exposes /actuator/health for the docker-compose
         healthcheck so service ordering (tutor-api → tutor-ui) waits
         on a real readiness signal instead of any-200-from-port-8080. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-websocket</artifactId>
    </dependency>

    <!-- LLM provider — OpenAI (cloud default) -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-openai-spring-boot-starter</artifactId>
    </dependency>

    <!-- LLM provider — Ollama (self-hosted, activated by the
         "selfhost" Spring profile via application-selfhost.properties).
         Both starters can coexist on the classpath because Spring AI's
         auto-config gates each set of beans on its own properties:
         OpenAI needs spring.ai.openai.api-key; Ollama needs
         spring.ai.ollama.base-url. The compose stack sets only the
         Ollama property, so only Ollama beans get created there. -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-ollama-spring-boot-starter</artifactId>
    </dependency>

    <!-- PDF text extraction for /api/syllabus/extract.
         PDFBox is the lightest mainstream option for this — pure Java,
         no Tika cascade, no native deps. Used only on the upload path. -->
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>3.0.3</version>
    </dependency>

    <!-- JDBC stack for the M3-JDBC mastery store + M1's pgvector
         episodic memory in selfhost mode. Pulls in HikariCP +
         spring-jdbc transitively. The driver is only needed when
         spring.datasource.url is set; without it the auto-config
         skips DataSource creation, so cloud / dev mode is unaffected. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Test scope — JUnit + Spring test harness for the memory smoke test
         and any future end-to-end pipeline tests. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Embedded H2 — used by JdbcMasteryGraphStoreTest (M3-JDBC) so the
         JDBC store can be exercised without a Postgres container. The
         store's DDL is portable (TEXT for the history blob, no jsonb)
         so the same SQL runs on H2 in tests and Postgres in production. -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
      </plugin>
    </plugins>
  </build>

</project>
