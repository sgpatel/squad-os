# Copy to `.env` and edit. docker-compose picks up .env automatically.
#
# Everything below has sensible defaults baked into docker-compose.yml,
# so a fresh `cp .env.example .env && docker compose up -d` works
# without changing any value here.

# ── Postgres (M1 pgvector + M3 mastery JDBC store) ───────────────────
POSTGRES_DB=tutoros
POSTGRES_USER=tutoros
POSTGRES_PASSWORD=tutoros
POSTGRES_PORT=5432

# ── Ollama (local LLM + embedder) ────────────────────────────────────
# Chat model. Smallest stable model that emits clean JSON for our
# structured-output agents is llama3.2:3b. Bumping to qwen2.5:7b or
# llama3.1:8b improves answer quality at the cost of disk + RAM.
OLLAMA_CHAT_MODEL=llama3.2:3b

# Embedding model. nomic-embed-text is 768 dimensions — match this
# with EMBED_DIMS below. If you switch to another embedder, update
# both. (mxbai-embed-large=1024, bge-large=1024, all-minilm=384.)
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBED_DIMS=768

OLLAMA_PORT=11434

# ── Ports ────────────────────────────────────────────────────────────
TUTOR_API_PORT=8080
TUTOR_UI_PORT=5173

# ── Cloud override (optional) ────────────────────────────────────────
# Set this to flip the LLM back to OpenAI without touching code.
# When set, also add SQUAD_LLM_PROVIDER=openai in tutor-api's env so
# SquadOS doesn't try to route through Ollama.
# OPENAI_API_KEY=sk-...
