    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <source>21</source><target>21</target><release>21</release>
          <!-- Exclude adapter classes that need Spring AI / LangChain4j -->
          <excludes>
            <exclude>io/squados/llm/adapter/SpringAiLlmAdapter.java</exclude>
            <exclude>io/squados/memory/retrieval/LangChain4jEmbeddingAdapter.java</exclude>
          </excludes>
        </configuration>
      </plugin>
