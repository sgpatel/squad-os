<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.sgpatel</groupId>
    <artifactId>squad-os</artifactId>
    <version>2.0.0</version>
  </parent>
  <artifactId>squad-core</artifactId>
  <name>SquadOS Core</name>
  <description>Phase 1-6: zero runtime dependencies. Adapters live in squad-starter.</description>

  <!-- squad-core intentionally has NO runtime dependencies.
       Spring AI and LangChain4j adapters live in squad-starter. -->

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <source>21</source><target>21</target><release>21</release>
          <!-- Exclude adapter classes that need Spring AI / LangChain4j -->
          <excludes>
            <exclude>io/squados/llm/adapter/SpringAiLlmAdapter.java</exclude>
            <exclude>io/squados/memory/retrieval/LangChain4jEmbeddingAdapter.java</exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution><id>phase1-tests</id><phase>test</phase><goals><goal>java</goal></goals>
            <configuration><mainClass>io.squados.tests.SquadOsPhase1Tests</mainClass><classpathScope>test</classpathScope></configuration>
          </execution>
          <execution><id>phase2-tests</id><phase>test</phase><goals><goal>java</goal></goals>
            <configuration><mainClass>io.squados.tests.SquadOsPhase2Tests</mainClass><classpathScope>test</classpathScope></configuration>
          </execution>
          <execution><id>phase3-tests</id><phase>test</phase><goals><goal>java</goal></goals>
            <configuration><mainClass>io.squados.tests.SquadOsPhase3Tests</mainClass><classpathScope>test</classpathScope></configuration>
          </execution>
          <execution><id>phase4-tests</id><phase>test</phase><goals><goal>java</goal></goals>
            <configuration><mainClass>io.squados.tests.SquadOsPhase4Tests</mainClass><classpathScope>test</classpathScope></configuration>
          </execution>
          <execution><id>phase5-tests</id><phase>test</phase><goals><goal>java</goal></goals>
            <configuration><mainClass>io.squados.tests.SquadOsPhase5Tests</mainClass><classpathScope>test</classpathScope></configuration>
          </execution>
          <execution><id>phase6-tests</id><phase>test</phase><goals><goal>java</goal></goals>
            <configuration><mainClass>io.squados.tests.SquadOsPhase6Tests</mainClass><classpathScope>test</classpathScope></configuration>
          </execution>
          <execution><id>phase7-tests</id><phase>test</phase><goals><goal>java</goal></goals>
            <configuration><mainClass>io.squados.tests.SquadOsPhase7Tests</mainClass><classpathScope>test</classpathScope></configuration>
          </execution>
          <execution><id>phase8-tests</id><phase>test</phase><goals><goal>java</goal></goals>
            <configuration><mainClass>io.squados.tests.SquadOsPhase8Tests</mainClass><classpathScope>test</classpathScope></configuration>
          </execution>
          <execution><id>phase9-tests</id><phase>test</phase><goals><goal>java</goal></goals>
            <configuration><mainClass>io.squados.tests.SquadOsPhase9Tests</mainClass><classpathScope>test</classpathScope></configuration>
          </execution>
          <execution><id>phase10-tests</id><phase>test</phase><goals><goal>java</goal></goals>
            <configuration><mainClass>io.squados.tests.SquadOsPhase10Tests</mainClass><classpathScope>test</classpathScope></configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
