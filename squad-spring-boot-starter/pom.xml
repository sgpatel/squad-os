<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.sgpatel</groupId>
    <artifactId>squad-os</artifactId>
    <version>3.9.0</version>
  </parent>
  <artifactId>squad-spring-boot-starter</artifactId>
  <name>SquadOS Spring Boot Starter</name>
  <description>Zero-config Spring Boot auto-configuration for SquadOS.
    LLM model dependencies are NOT included — add your own model starter.
  </description>

  <properties>
    <spring-boot.version>3.3.0</spring-boot.version>
    <spring-ai.version>1.0.0</spring-ai.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type><scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type><scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>

    <!-- ── SquadOS Core (always required) ─────────────────────────────── -->
    <dependency>
      <groupId>io.github.sgpatel</groupId>
      <artifactId>squad-core</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- ── SquadOS MCP Server (optional — for @McpServer exposure) ──────── -->
    <dependency>
      <groupId>io.github.sgpatel</groupId>
      <artifactId>squad-mcp-server</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>

    <!-- ── Spring Boot (always required) ──────────────────────────────── -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>

    <!-- ── Spring AI Core — compile-only; SpringAiLlmAdapter + Embedding ─
         NO model is included here by design.
         Add exactly ONE of the following to your application pom:

           Ollama (local):
             <dependency>
               <groupId>org.springframework.ai</groupId>
               <artifactId>spring-ai-starter-model-ollama</artifactId>
             </dependency>

           OpenAI:
             <dependency>
               <groupId>org.springframework.ai</groupId>
               <artifactId>spring-ai-starter-model-openai</artifactId>
             </dependency>

           Anthropic Claude:
             <dependency>
               <groupId>org.springframework.ai</groupId>
               <artifactId>spring-ai-starter-model-anthropic</artifactId>
             </dependency>

           AWS Bedrock:
             <dependency>
               <groupId>org.springframework.ai</groupId>
               <artifactId>spring-ai-starter-model-bedrock</artifactId>
             </dependency>

           Azure OpenAI:
             <dependency>
               <groupId>org.springframework.ai</groupId>
               <artifactId>spring-ai-starter-model-azure-openai</artifactId>
             </dependency>

         Then set in application.properties:
           squad.llm.provider=openai          # or ollama, anthropic, bedrock, azure-openai
           squad.llm.model=gpt-4o             # model name for the chosen provider
    ──────────────────────────────────────────────────────────────────── -->
    <!-- Spring AI — compile-only; no model is included here by design.
         ChatClient, ChatResponse, Usage, EmbeddingModel are all optional.
         See pom comment above for which model starter to add. -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-client-chat</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-model</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- ── Spring Web MVC — optional; only needed for @AgentAPI HTTP routes ─
         Activated when squad.agent-api.enabled=true.
         Add spring-boot-starter-web to your app if not already present.
    ──────────────────────────────────────────────────────────────────── -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- ── Config metadata (IDE autocomplete for application.properties) ─ -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

  </dependencies>
</project>
